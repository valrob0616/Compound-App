{
  "expo": {
    "name": "Homestead Compound News",
    "slug": "homestead-compound-news",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homesteadcompound",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imconintl.homesteadcompound",
      "infoPlist": {
        "CFBundleDisplayName": "Homestead Compound News",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.imconintl.homesteadcompound",
      "adaptiveIcon": {
        "backgroundColor": "#2C4A3E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2C4A3E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://valrob0616.github.io/Compound-App/privacy.html",
      "termsOfUseUrl": "https://valrob0616.github.io/Compound-App/terms.html",
      "privacyContactEmail": "rob@imconintl.com"
    }
  }
}
