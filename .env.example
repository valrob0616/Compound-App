# Copy to `.env` or `.env.local`. Never commit real secrets.
# Expo inlines only variables prefixed with EXPO_PUBLIC_.

# Amazon Associates tracking ID (not a secret, but yours).
# Used after Store launch when STORE_CATALOG_ENABLED is true.
# Replace the placeholder before shipping a catalog-enabled build.
EXPO_PUBLIC_AMAZON_ASSOCIATE_TAG=yourtag-20

# Release and store builds need both of these. They are public.
# EXPO_PUBLIC_SUPABASE_URL is the project URL (https://<project-ref>.supabase.co).
# EXPO_PUBLIC_SUPABASE_KEY is the publishable key (sb_publishable_...).
# Do not put a service-role key, secret key, or sb_secret_ value in either variable.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_your_key

# Local development only, used when the two Supabase variables above are unset.
# The app then calls the in-repo account server. Store builds do not use this.
# EXPO_PUBLIC_API_URL=http://localhost:8787
# Android emulator: http://10.0.2.2:8787
# PORT=8787
# HOST=0.0.0.0
# ACCOUNTS_DATA_FILE=server/data/accounts.json
# BCRYPT_ROUNDS=10

# Optional public legal URLs for store listings and “Open hosted page” in-app.
# Defaults match GitHub Pages from the docs/ folder after Pages is enabled.
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://valrob0616.github.io/Compound-App/privacy.html
# EXPO_PUBLIC_TERMS_OF_USE_URL=https://valrob0616.github.io/Compound-App/terms.html
# EXPO_PUBLIC_PRIVACY_CONTACT_EMAIL=rob@loudfh.com
